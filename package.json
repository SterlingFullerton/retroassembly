{
  "private": true,
  "repository": "SterlingFullerton/retroassembly",
  "type": "module",
  "imports": {
    "#@/*": "./src/*"
  },
  "scripts": {
    "build": "node --run=build:client && node --run=build:server",
    "build:client": "react-router build && node scripts/precompress.ts",
    "build:server": "go -C server build -tags nodynamic -o ../dist/retroassembly ./cmd/retroassembly",
    "dev": "react-router dev",
    "dev:test": "node --run=test -- --headed --ui",
    "lint": "vp check",
    "serve": "dist/retroassembly",
    "setup": "node scripts/setup.ts",
    "start": "node --run=serve",
    "tag": "node scripts/tag.ts",
    "test": "playwright test -c tests/e2e --tsconfig=tests/e2e/tsconfig.playwright.json",
    "test:go": "go -C server vet ./... && go -C server test ./...",
    "test:unit": "node --test tests/unit/*.test.ts"
  },
  "devDependencies": {
    "@arianrhodsandlot/vite-plus-config": "1.3.3",
    "@iconify-json/logos": "1.2.15",
    "@iconify-json/mdi": "1.2.3",
    "@iconify-json/noto": "1.2.9",
    "@iconify-json/simple-icons": "1.2.99",
    "@iconify-json/svg-spinners": "1.2.4",
    "@iconify-json/twemoji": "1.2.5",
    "@iconify/tailwind4": "1.2.3",
    "@playwright/test": "1.64.0",
    "@radix-ui/themes": "3.3.0",
    "@react-router/dev": "8.4.0",
    "@react-router/node": "8.4.0",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.3.3",
    "@tsconfig/remix": "2.0.7",
    "@types/canvas-confetti": "1.9.0",
    "@types/fs-extra": "11.0.4",
    "@types/luxon": "3.7.6",
    "@types/nanoid-dictionary": "4.2.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sax": "1.2.7",
    "@types/spark-md5": "3.0.5",
    "@zip.js/zip.js": "2.23.0",
    "atropos": "2.0.2",
    "browser-fs-access": "0.38.0",
    "canvas-confetti": "1.9.4",
    "clsx": "2.1.1",
    "delegated-events": "1.1.2",
    "drizzle-kit": "0.31.11",
    "drizzle-orm": "0.45.4",
    "embla-carousel-react": "8.6.0",
    "es-toolkit": "1.52.0",
    "esbuild": "0.28.2",
    "execa": "10.1.0",
    "fs-extra": "11.4.1",
    "gamepad.js": "3.0.1",
    "goodcodes-parser": "2.5.0",
    "i18next": "26.4.3",
    "is-docker": "4.0.0",
    "isbot": "5.2.2",
    "jotai": "3.0.1",
    "jotai-ssr": "0.2.0",
    "libretrodb": "1.0.0",
    "luxon": "3.7.2",
    "motion": "14.1.0",
    "nanoid": "6.0.2",
    "nanoid-dictionary": "5.0.0",
    "next-themes": "0.4.6",
    "nosleep.js": "0.12.0",
    "nostalgist": "0.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-dropzone": "20.1.3",
    "react-i18next": "17.0.16",
    "react-router": "8.4.0",
    "sax": "1.5.0",
    "smooth-scroll-into-view-if-needed": "2.0.2",
    "spark-md5": "3.0.2",
    "spatial-navigation-ts": "1.0.8",
    "swr": "2.5.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tailwindcss-motion": "1.1.1",
    "tailwindcss-safe-area": "1.3.0",
    "tempy": "3.2.0",
    "typescript": "7.0.2",
    "vite-plugin-devtools-json": "1.1.1",
    "vite-plus": "1.1.0"
  },
  "engines": {
    "node": ">=26.5.0"
  },
  "packageManager": "pnpm@12.11.2",
  "hintConfig": {
    "extends": [
      "development"
    ],
    "hints": {
      "apple-touch-icons": "off",
      "compat-api/html": [
        "default",
        {
          "ignore": [
            "meta[name=theme-color]"
          ]
        }
      ],
      "no-inline-styles": "off"
    }
  }
}
