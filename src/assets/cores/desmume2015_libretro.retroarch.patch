 #include <emscripten/html5.h>
 #include "../../frontend/drivers/platform_emscripten.h"
 
+/* Scale from the canvas's size on the page to the size RetroArch draws at. The page can resize the canvas without
+ * RetroArch hearing about it, and then the device pixel ratio alone puts clicks and touches in the wrong place. */
+static void rwebinput_get_canvas_scale(double *scale_x, double *scale_y)
+{
+   int width      = 0;
+   int height     = 0;
+   double css_w   = 0;
+   double css_h   = 0;
+
+   platform_emscripten_get_canvas_size(&width, &height);
+   if (width > 0 && height > 0
+         && emscripten_get_element_css_size("#canvas", &css_w, &css_h) == EMSCRIPTEN_RESULT_SUCCESS
+         && css_w > 0 && css_h > 0)
+   {
+      *scale_x = width / css_w;
+      *scale_y = height / css_h;
+      return;
+   }
+
+   *scale_x = *scale_y = platform_emscripten_get_dpr();
+}
+
 #include "../input_driver.h"
 #include "../input_types.h"
 #include "../input_keymaps.h"
