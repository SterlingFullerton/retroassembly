+// Polygons that should meet exactly (map tiles, for one) can leave single pixels between them that no polygon covers,
+// and the clear color shows through as specks. Fill each such pixel from a neighbour when it has drawn pixels on both
+// sides, before edge marking and fog run.
+void SoftRasterizerRenderer::FillPolygonCracks()
+{
+	if (this->currentRenderState->enableClearImage)
+		return;
+
+	const u32 clearDepth = this->currentRenderState->clearDepth;
+	const size_t w = this->_framebufferWidth;
+	const size_t h = this->_framebufferHeight;
+	FragmentAttributesBuffer &attr = *this->_framebufferAttributes;
+
+	for (size_t y = 1; y + 1 < h; y++)
+	{
+		for (size_t x = 1; x + 1 < w; x++)
+		{
+			const size_t i = y * w + x;
+			if (attr.depth[i] != clearDepth)
+				continue;
+
+			size_t src;
+			if (attr.depth[i - 1] != clearDepth && attr.depth[i + 1] != clearDepth)
+				src = i - 1;
+			else if (attr.depth[i - w] != clearDepth && attr.depth[i + w] != clearDepth)
+				src = i - w;
+			else
+				continue;
+
+			this->_framebufferColor[i] = this->_framebufferColor[src];
+			attr.depth[i] = attr.depth[src];
+			attr.opaquePolyID[i] = attr.opaquePolyID[src];
+			attr.translucentPolyID[i] = attr.translucentPolyID[src];
+			attr.stencil[i] = attr.stencil[src];
+			attr.isFogged[i] = attr.isFogged[src];
+			attr.isTranslucentPoly[i] = attr.isTranslucentPoly[src];
+		}
+	}
+}
