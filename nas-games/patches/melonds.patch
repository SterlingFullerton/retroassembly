+    };
+
+    *(u16*)&Firmware[0x2C] = 0x138;
+    Firmware[0x2E] = 0;
+    *(u32*)&Firmware[0x30] = 0xFFFFFFFF;
+    *(u16*)&Firmware[0x34] = 0x00FF;
+    memcpy(&Firmware[0x36], defaultmac, 6);
+    *(u16*)&Firmware[0x3C] = 0x3FFE;
+    *(u16*)&Firmware[0x3E] = 0xFFFF;
+    Firmware[0x40] = 0x03;
+    Firmware[0x41] = 0x94;
+    Firmware[0x42] = 0x29;
